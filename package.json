{
  "name": "mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prestart": "node ../scripts/dev-guard.mjs mobile && node ../scripts/sync-dev-network-env.mjs",
    "start": "expo start --go",
    "prestart:clear": "node ../scripts/dev-guard.mjs mobile && node ../scripts/sync-dev-network-env.mjs",
    "start:clear": "expo start --go --clear",
    "prestart:tunnel": "node ../scripts/dev-guard.mjs mobile && node ../scripts/sync-dev-network-env.mjs",
    "start:tunnel": "expo start --go --tunnel",
    "preandroid": "node ../scripts/dev-guard.mjs mobile && node ../scripts/sync-dev-network-env.mjs",
    "android": "expo run:android",
    "preios": "node ../scripts/dev-guard.mjs mobile && node ../scripts/sync-dev-network-env.mjs",
    "ios": "expo run:ios",
    "preweb": "node ../scripts/dev-guard.mjs mobile && node ../scripts/sync-dev-network-env.mjs",
    "web": "expo start --web"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/poppins": "^0.4.1",
    "@expo-google-fonts/space-mono": "^0.4.2",
    "@expo/ngrok": "^4.1.3",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-navigation/bottom-tabs": "^7.15.6",
    "@react-navigation/native": "^7.1.34",
    "@react-navigation/native-stack": "^7.14.6",
    "@tanstack/react-query": "^5.91.2",
    "axios": "^1.13.6",
    "date-fns": "^4.1.0",
    "expo": "~57.0.18",
    "expo-constants": "~57.0.16",
    "expo-dev-client": "~57.0.16",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.2",
    "expo-image-picker": "~57.0.14",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.8",
    "expo-location": "~57.0.9",
    "expo-modules-core": "~57.0.14",
    "expo-network": "~57.0.1",
